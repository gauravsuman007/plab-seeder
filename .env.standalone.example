# Copy to .env next to docker-compose.standalone.yml and fill in as needed.
# Nothing here is required to start the stack.

# Host ports (defaults avoid every other stack's ports already in use on
# this host: vpngate-torrent's 8010/8080/8081, plab-register's 8020, and
# the tailscale-standalone stack's 8030/8091/8882)
QBIT_WEBUI_PORT=8092
QBIT_TORRENT_PORT=8883
SEEDER_PORT=8040

PUID=1000
PGID=1000
TZ=UTC

APP_PASSWORD=
ANTHROPIC_API_KEY=
