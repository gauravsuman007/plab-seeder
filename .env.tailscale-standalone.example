# Copy to .env next to docker-compose.tailscale-standalone.yml and fill in as needed.
# Nothing here is required to start the stack -- Tailscale will print a
# one-time login URL in its logs if TS_AUTHKEY is left empty.

# Tailscale (https://login.tailscale.com/admin/settings/keys) -- optional,
# unattended join. Leave empty to authorize via the printed login URL instead.
TS_AUTHKEY=
TS_HOSTNAME=pornolab-seeder-tscale
# e.g. --exit-node=100.x.y.z to route qBittorrent's traffic through another
# device on your tailnet instead of this host's own connection.
TS_EXTRA_ARGS=

# Host ports (defaults already avoid the vpngate-torrent stack's 8010/8080/8081)
QBIT_WEBUI_PORT=8091
QBIT_TORRENT_PORT=8882
SEEDER_PORT=8020

PUID=1000
PGID=1000
TZ=UTC

APP_PASSWORD=
ANTHROPIC_API_KEY=
